# ==========================================
# SHERUBTSE CAMPUS RIDE - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your values
# DO NOT put real passwords or secrets in this file!
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_a_secure_random_string_in_production

# PostgreSQL Database Configuration (Local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password_here
DB_NAME=campus_ride_db

# Alternative: Cloud PostgreSQL Connection URI (e.g. Neon)
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Ride Booking Settings
CAMPUS_NAME=Sherubtse College, Kanglung, Bhutan
ALLOW_PASSENGER_REGISTRATION=true
