<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  
  <div class="mb-4">
    <a href="/driver" class="inline-flex items-center text-xs font-semibold text-slate-500 hover:text-brand-600 transition">
      <i class="fa-solid fa-arrow-left mr-1.5"></i> Back to Driver Shifts
    </a>
  </div>

  <!-- Trip Info & Status Control Card -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs mb-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-6 border-b border-slate-100">
      <div>
        <div class="flex items-center space-x-2 mb-1">
          <span class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-slate-100 text-slate-700">
            <%= trip.vehicle_plate %> (<%= trip.vehicle_model %>)
          </span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full <%= trip.status === 'BOARDING' ? 'bg-amber-100 text-amber-800 animate-pulse' : (trip.status === 'IN_TRANSIT' ? 'bg-blue-100 text-blue-800' : (trip.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700')) %>">
            <%= trip.status %>
          </span>
        </div>
        <h1 class="text-2xl font-black text-slate-900"><%= trip.route_name %></h1>
        <p class="text-xs text-slate-500 mt-1">
          From <span class="font-bold text-slate-700"><%= trip.origin_stop_name %></span> to <span class="font-bold text-slate-700"><%= trip.destination_stop_name %></span>
          • Scheduled: <%= new Date(trip.departure_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
        </p>
      </div>

      <!-- Real-time Status Update Controls -->
      <form action="/driver/trips/<%= trip.id %>/status" method="POST" class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold uppercase text-slate-400 mr-1">Update Status:</span>
        <button type="submit" name="status" value="BOARDING" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl shadow-xs transition">
          <i class="fa-solid fa-door-open mr-1"></i> Boarding
        </button>
        <button type="submit" name="status" value="IN_TRANSIT" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
          <i class="fa-solid fa-van-shuttle mr-1"></i> In Transit
        </button>
        <button type="submit" name="status" value="COMPLETED" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
          <i class="fa-solid fa-check mr-1"></i> Completed
        </button>
      </form>
    </div>

    <!-- Capacity Meter -->
    <div class="mt-4 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-600 gap-2">
      <div class="flex items-center space-x-2">
        <i class="fa-solid fa-users text-brand-600"></i>
        <span>Booked: <strong><%= trip.vehicle_capacity - trip.available_seats %></strong> / <strong><%= trip.vehicle_capacity %></strong> seats</span>
      </div>
      <div>
        <span>Remaining seats available: <strong><%= trip.available_seats %></strong></span>
      </div>
    </div>
  </div>

  <!-- Passenger Manifest Table -->
  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
      <h3 class="text-sm font-bold text-slate-900">Passenger Boarding Manifest (<%= passengers.length %> Bookings)</h3>
      <button onclick="window.print()" class="text-xs font-semibold text-slate-600 hover:text-brand-600 flex items-center space-x-1">
        <i class="fa-solid fa-print"></i>
        <span>Print Manifest</span>
      </button>
    </div>

    <% if (passengers && passengers.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-100 text-slate-500 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="px-6 py-3">Booking Code</th>
              <th class="px-6 py-3">Student / Passenger</th>
              <th class="px-6 py-3">Student ID</th>
              <th class="px-6 py-3">Phone</th>
              <th class="px-6 py-3 text-center">Seats</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3 text-center">Boarded Check</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium">
            <% passengers.forEach(p => { %>
              <tr class="hover:bg-slate-50 transition <%= p.status === 'CANCELLED' ? 'opacity-40 bg-slate-50' : '' %>">
                <td class="px-6 py-3 font-mono font-bold text-slate-900"><%= p.booking_code %></td>
                <td class="px-6 py-3">
                  <div class="font-bold text-slate-900"><%= p.passenger_name %></div>
                  <div class="text-[10px] text-slate-400"><%= p.passenger_email %></div>
                </td>
                <td class="px-6 py-3 font-mono"><%= p.student_staff_id || 'N/A' %></td>
                <td class="px-6 py-3"><%= p.passenger_phone || 'None' %></td>
                <td class="px-6 py-3 text-center font-bold text-slate-900"><%= p.seats_booked %></td>
                <td class="px-6 py-3">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= p.status === 'CONFIRMED' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                    <%= p.status %>
                  </span>
                </td>
                <td class="px-6 py-3 text-center">
                  <% if (p.status === 'CONFIRMED') { %>
                    <input type="checkbox" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 cursor-pointer" title="Mark student present">
                  <% } else { %>
                    <span class="text-rose-400 text-xs">Void</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-8 text-center text-slate-400">
        <i class="fa-solid fa-user-xmark text-3xl mb-2 text-slate-300"></i>
        <p class="text-xs">No passengers have booked this shuttle yet.</p>
      </div>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
