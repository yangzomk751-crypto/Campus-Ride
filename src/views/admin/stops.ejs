<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 mb-2">
        <i class="fa-solid fa-location-dot"></i>
        <span>Infrastructure</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Campus Shuttle Stops</h1>
      <p class="text-sm text-slate-500">Manage pickup and dropoff points across university grounds</p>
    </div>

    <button onclick="document.getElementById('addStopModal').classList.remove('hidden')" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs transition flex items-center space-x-1.5">
      <i class="fa-solid fa-plus"></i>
      <span>Add New Stop</span>
    </button>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-100 text-slate-500 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-6 py-3">Code</th>
            <th class="px-6 py-3">Stop Name</th>
            <th class="px-6 py-3">Location & Landmark</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% stops.forEach(stop => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-3 font-mono font-bold text-slate-900"><%= stop.code %></td>
              <td class="px-6 py-3 font-bold text-slate-800"><%= stop.name %></td>
              <td class="px-6 py-3 text-slate-500 max-w-sm truncate"><%= stop.location_description || 'None' %></td>
              <td class="px-6 py-3">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= stop.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
                  <%= stop.is_active ? 'ACTIVE' : 'INACTIVE' %>
                </span>
              </td>
              <td class="px-6 py-3 text-right">
                <form action="/admin/stops/<%= stop.id %>/delete" method="POST" onsubmit="return confirm('Delete this stop? Routes using this stop will prevent deletion.');" class="inline">
                  <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold p-1">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Stop Modal -->
  <div id="addStopModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-base font-bold text-slate-900">Add New Campus Stop</h3>
        <button type="button" onclick="document.getElementById('addStopModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form action="/admin/stops" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Stop Name *</label>
          <input type="text" name="name" required placeholder="e.g. Science Complex North"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Stop Code *</label>
          <input type="text" name="code" required placeholder="e.g. STOP-SCI"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-mono uppercase focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Location Details / Landmark</label>
          <textarea name="locationDescription" rows="2" placeholder="e.g. In front of Tech Hall 2, near bike racks"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none"></textarea>
        </div>

        <div class="flex items-center space-x-2">
          <input type="checkbox" name="isActive" id="isActive" checked class="w-4 h-4 rounded text-brand-600">
          <label for="isActive" class="text-xs font-semibold text-slate-700">Active stop for bookings</label>
        </div>

        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="document.getElementById('addStopModal').classList.add('hidden')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs">
            Save Stop
          </button>
        </div>
      </form>
    </div>
  </div>

</main>

<%- include('../partials/footer') %>
