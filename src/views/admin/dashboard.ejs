<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 mb-2">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Admin Command Center</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Campus Transport Operations</h1>
      <p class="text-sm text-slate-500">Live operational overview of university shuttles, dispatch, and bookings</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a href="/admin/trips" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs transition flex items-center space-x-1.5">
        <i class="fa-solid fa-plus"></i>
        <span>Dispatch New Trip</span>
      </a>
      <a href="/admin/vehicles" class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 shadow-xs transition">
        Manage Fleet
      </a>
    </div>
  </div>

  <!-- KPI Metric Cards Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold uppercase text-slate-400">Total Bookings</span>
        <span class="w-8 h-8 rounded-lg bg-blue-50 text-brand-600 flex items-center justify-center text-sm">
          <i class="fa-solid fa-ticket"></i>
        </span>
      </div>
      <div class="text-2xl font-black text-slate-900"><%= stats.total_bookings || 0 %></div>
      <p class="text-[11px] text-emerald-600 font-semibold mt-1">
        <%= stats.active_bookings || 0 %> active confirmed
      </p>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold uppercase text-slate-400">Active Shuttles</span>
        <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
          <i class="fa-solid fa-van-shuttle"></i>
        </span>
      </div>
      <div class="text-2xl font-black text-slate-900"><%= stats.activeVehicles %> / <%= stats.totalVehicles %></div>
      <p class="text-[11px] text-slate-400 font-semibold mt-1">Ready for campus dispatch</p>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold uppercase text-slate-400">Campus Community</span>
        <span class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
          <i class="fa-solid fa-users"></i>
        </span>
      </div>
      <div class="text-2xl font-black text-slate-900"><%= stats.total_users || 0 %> Users</div>
      <p class="text-[11px] text-purple-600 font-semibold mt-1">
        <%= stats.passengers || 0 %> students • <%= stats.drivers || 0 %> drivers
      </p>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold uppercase text-slate-400">Satisfaction</span>
        <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center text-sm">
          <i class="fa-solid fa-star"></i>
        </span>
      </div>
      <div class="text-2xl font-black text-slate-900"><%= stats.avgRating %> ★</div>
      <p class="text-[11px] text-amber-600 font-semibold mt-1">
        <%= stats.totalReviews %> passenger reviews
      </p>
    </div>
  </div>

  <!-- Operational Grid: Recent Bookings & Reviews -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left 2 cols: Recent Bookings Ledger -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50">
        <h3 class="text-sm font-bold text-slate-900">Recent Passenger Bookings</h3>
        <a href="/admin/bookings" class="text-xs font-semibold text-brand-600 hover:text-brand-800">View All Bookings &rarr;</a>
      </div>

      <% if (recentBookings && recentBookings.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-100 text-slate-500 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
              <tr>
                <th class="px-5 py-3">Code</th>
                <th class="px-5 py-3">Student</th>
                <th class="px-5 py-3">Route</th>
                <th class="px-5 py-3 text-center">Seats</th>
                <th class="px-5 py-3">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium">
              <% recentBookings.forEach(b => { %>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-5 py-3 font-mono font-bold text-slate-900"><%= b.booking_code %></td>
                  <td class="px-5 py-3">
                    <span class="font-bold text-slate-800"><%= b.passenger_name %></span>
                    <span class="text-[10px] text-slate-400 block"><%= b.student_staff_id || b.passenger_email %></span>
                  </td>
                  <td class="px-5 py-3"><%= b.route_name %></td>
                  <td class="px-5 py-3 text-center font-bold text-slate-900"><%= b.seats_booked %></td>
                  <td class="px-5 py-3">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= b.status === 'CONFIRMED' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                      <%= b.status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="p-8 text-center text-xs text-slate-400">No bookings logged yet.</p>
      <% } %>
    </div>

    <!-- Right col: Recent Passenger Feedback -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <h3 class="text-sm font-bold text-slate-900 mb-4 pb-3 border-b border-slate-100 flex items-center justify-between">
          <span>Student Feedback</span>
          <i class="fa-solid fa-comment-dots text-slate-400"></i>
        </h3>

        <% if (recentFeedback && recentFeedback.length > 0) { %>
          <div class="space-y-4">
            <% recentFeedback.forEach(f => { %>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 text-xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-slate-800"><%= f.passenger_name %></span>
                  <div class="text-amber-400 text-[10px]">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="fa-star <%= i <= f.rating ? 'fa-solid' : 'fa-regular text-slate-200' %>"></i>
                    <% } %>
                  </div>
                </div>
                <p class="text-slate-600 italic">"<%= f.comment || 'Good ride.' %>"</p>
                <span class="text-[10px] text-slate-400 mt-1 block"><%= f.route_name %> • <%= f.vehicle_plate %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-center py-8 text-xs text-slate-400">No student reviews recorded yet.</p>
        <% } %>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] text-slate-400">
        <span>Average University Transit Score: <strong><%= stats.avgRating %> / 5.0</strong></span>
      </div>
    </div>

  </div>

</main>

<%- include('../partials/footer') %>
