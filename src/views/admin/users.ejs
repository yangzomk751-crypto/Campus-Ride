<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 mb-2">
        <i class="fa-solid fa-users-gear"></i>
        <span>User Accounts</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Campus User Directory</h1>
      <p class="text-sm text-slate-500">Manage user roles and permissions across students, shuttle drivers, and staff</p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-100 text-slate-500 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-5 py-3">User</th>
            <th class="px-5 py-3">Student / Staff ID</th>
            <th class="px-5 py-3">Phone</th>
            <th class="px-5 py-3">Current Role</th>
            <th class="px-5 py-3">Change Role</th>
            <th class="px-5 py-3 text-right">Joined</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% users.forEach(u => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-5 py-3">
                <div class="font-bold text-slate-900"><%= u.full_name %></div>
                <div class="text-[10px] text-slate-400"><%= u.email %></div>
              </td>
              <td class="px-5 py-3 font-mono font-bold text-slate-800"><%= u.student_staff_id || 'N/A' %></td>
              <td class="px-5 py-3"><%= u.phone || 'None' %></td>
              <td class="px-5 py-3">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= u.role === 'admin' ? 'bg-purple-100 text-purple-800' : (u.role === 'driver' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800') %>">
                  <%= u.role %>
                </span>
              </td>
              <td class="px-5 py-3">
                <form action="/admin/users/<%= u.id %>/role" method="POST" class="inline">
                  <select name="role" onchange="this.form.submit()" class="text-xs font-semibold py-1 px-2 rounded-lg border border-slate-300 bg-white cursor-pointer focus:outline-none">
                    <option value="passenger" <%= u.role === 'passenger' ? 'selected' : '' %>>passenger</option>
                    <option value="driver" <%= u.role === 'driver' ? 'selected' : '' %>>driver</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                  </select>
                </form>
              </td>
              <td class="px-5 py-3 text-right text-slate-400">
                <%= new Date(u.created_at).toLocaleDateString() %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('../partials/footer') %>
