<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 mb-2">
        <i class="fa-solid fa-map-location-dot"></i>
        <span>Network Topography</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Campus Transit Routes</h1>
      <p class="text-sm text-slate-500">Configure point-to-point shuttle pathways and estimated durations</p>
    </div>

    <button onclick="document.getElementById('addRouteModal').classList.remove('hidden')" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs transition flex items-center space-x-1.5">
      <i class="fa-solid fa-plus"></i>
      <span>Add New Route</span>
    </button>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-100 text-slate-500 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-6 py-3">Route Name</th>
            <th class="px-6 py-3">Origin Stop</th>
            <th class="px-6 py-3">Destination Stop</th>
            <th class="px-6 py-3 text-center">Distance</th>
            <th class="px-6 py-3 text-center">Est. Duration</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% routes.forEach(route => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-3 font-bold text-slate-900"><%= route.name %></td>
              <td class="px-6 py-3">
                <span class="font-semibold text-slate-800"><%= route.origin_stop_name %></span>
                <span class="text-[10px] text-slate-400 font-mono block"><%= route.origin_stop_code %></span>
              </td>
              <td class="px-6 py-3">
                <span class="font-semibold text-slate-800"><%= route.destination_stop_name %></span>
                <span class="text-[10px] text-slate-400 font-mono block"><%= route.destination_stop_code %></span>
              </td>
              <td class="px-6 py-3 text-center"><%= route.distance_km %> km</td>
              <td class="px-6 py-3 text-center font-bold text-slate-800"><%= route.estimated_duration_min %> min</td>
              <td class="px-6 py-3">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= route.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
                  <%= route.is_active ? 'ACTIVE' : 'INACTIVE' %>
                </span>
              </td>
              <td class="px-6 py-3 text-right">
                <form action="/admin/routes/<%= route.id %>/delete" method="POST" onsubmit="return confirm('Delete this route?');" class="inline">
                  <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold p-1">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Route Modal -->
  <div id="addRouteModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-base font-bold text-slate-900">Create Campus Route</h3>
        <button type="button" onclick="document.getElementById('addRouteModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form action="/admin/routes" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Route Name *</label>
          <input type="text" name="name" required placeholder="e.g. North Gate ➔ Library Direct"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Origin Stop *</label>
            <select name="originStopId" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
              <% stops.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Destination Stop *</label>
            <select name="destinationStopId" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
              <% stops.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Distance (km)</label>
            <input type="number" step="0.1" name="distanceKm" value="2.0"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Est. Duration (mins)</label>
            <input type="number" name="estimatedDurationMin" value="12"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
          </div>
        </div>

        <div class="flex items-center space-x-2">
          <input type="checkbox" name="isActive" id="routeIsActive" checked class="w-4 h-4 rounded text-brand-600">
          <label for="routeIsActive" class="text-xs font-semibold text-slate-700">Active route for scheduling</label>
        </div>

        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="document.getElementById('addRouteModal').classList.add('hidden')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs">
            Save Route
          </button>
        </div>
      </form>
    </div>
  </div>

</main>

<%- include('../partials/footer') %>
