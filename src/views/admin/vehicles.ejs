<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 mb-2">
        <i class="fa-solid fa-van-shuttle"></i>
        <span>Fleet Operations</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">University Fleet Vehicles</h1>
      <p class="text-sm text-slate-500">Manage campus transit buses, minivans, and zero-emission electric carts</p>
    </div>

    <button onclick="document.getElementById('addVehicleModal').classList.remove('hidden')" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs transition flex items-center space-x-1.5">
      <i class="fa-solid fa-plus"></i>
      <span>Add Vehicle</span>
    </button>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-100 text-slate-500 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-6 py-3">Plate / Fleet Code</th>
            <th class="px-6 py-3">Vehicle Model</th>
            <th class="px-6 py-3">Type</th>
            <th class="px-6 py-3 text-center">Capacity</th>
            <th class="px-6 py-3">Operational Status</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% vehicles.forEach(v => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-3 font-mono font-bold text-slate-900"><%= v.plate_number %></td>
              <td class="px-6 py-3 font-bold text-slate-800"><%= v.model_name %></td>
              <td class="px-6 py-3">
                <span class="inline-flex items-center space-x-1">
                  <i class="fa-solid <%= v.vehicle_type === 'Electric Cart' ? 'fa-bolt text-amber-500' : 'fa-van-shuttle text-brand-600' %> text-xs mr-1"></i>
                  <span><%= v.vehicle_type %></span>
                </span>
              </td>
              <td class="px-6 py-3 text-center font-bold text-slate-900"><%= v.capacity %> seats</td>
              <td class="px-6 py-3">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= v.status === 'ACTIVE' ? 'bg-emerald-100 text-emerald-800' : (v.status === 'MAINTENANCE' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600') %>">
                  <%= v.status %>
                </span>
              </td>
              <td class="px-6 py-3 text-right">
                <form action="/admin/vehicles/<%= v.id %>/delete" method="POST" onsubmit="return confirm('Remove this vehicle from fleet? Active trips will prevent deletion.');" class="inline">
                  <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold p-1">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Vehicle Modal -->
  <div id="addVehicleModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-base font-bold text-slate-900">Add Vehicle to Fleet</h3>
        <button type="button" onclick="document.getElementById('addVehicleModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form action="/admin/vehicles" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Plate Number / Unit Code *</label>
          <input type="text" name="plateNumber" required placeholder="e.g. CAMPUS-VAN-05"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-mono uppercase focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Model Name *</label>
          <input type="text" name="modelName" required placeholder="e.g. Mercedes Sprinter Shuttle"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Vehicle Type</label>
            <select name="vehicleType" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
              <option value="Shuttle Bus">Shuttle Bus</option>
              <option value="Minivan">Minivan</option>
              <option value="Electric Cart">Electric Cart</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Max Capacity *</label>
            <input type="number" name="capacity" required min="1" max="100" value="20"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Initial Status</label>
          <select name="status" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ACTIVE">ACTIVE</option>
            <option value="MAINTENANCE">MAINTENANCE</option>
            <option value="INACTIVE">INACTIVE</option>
          </select>
        </div>

        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="document.getElementById('addVehicleModal').classList.add('hidden')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-xs">
            Register Vehicle
          </button>
        </div>
      </form>
    </div>
  </div>

</main>

<%- include('../partials/footer') %>
