<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
  <div class="max-w-lg w-full text-center">
    <div class="w-20 h-20 mx-auto rounded-full bg-rose-50 flex items-center justify-center text-rose-500 text-3xl mb-4">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h1 class="text-4xl font-black text-slate-900 mb-2">500</h1>
    <h2 class="text-xl font-bold text-slate-700 mb-2">Internal Server Error</h2>
    <p class="text-sm text-slate-500 mb-6">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong on the server.' %>
    </p>

    <% if (typeof error !== 'undefined' && error && error.stack) { %>
      <div class="text-left bg-slate-900 text-slate-200 p-4 rounded-xl text-xs font-mono overflow-x-auto mb-6">
        <%= error.stack %>
      </div>
    <% } %>

    <a href="/" class="inline-flex items-center px-5 py-2.5 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-sm rounded-xl transition">
      <i class="fa-solid fa-house mr-2"></i> Back to Safety
    </a>
  </div>
</main>

<%- include('partials/footer') %>
