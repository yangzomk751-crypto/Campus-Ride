<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-6">
    
    <div class="text-center">
      <div class="w-14 h-14 rounded-2xl bg-brand-600 flex items-center justify-center text-white mx-auto shadow-lg shadow-brand-500/30 mb-3">
        <i class="fa-solid fa-user-plus text-2xl"></i>
      </div>
      <h2 class="text-2xl font-extrabold text-slate-900">Create Campus Account</h2>
      <p class="text-xs text-slate-500 mt-1">Join the campus transit system to book seats & passes</p>
    </div>

    <div class="bg-white py-8 px-6 shadow-sm border border-slate-200 rounded-2xl sm:px-8">
      <form action="/register" method="POST" class="space-y-4">
        
        <div>
          <label for="fullName" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
            Full Name *
          </label>
          <input id="fullName" name="fullName" type="text" required
            value="<%= typeof formData !== 'undefined' && formData.fullName ? formData.fullName : '' %>"
            placeholder="e.g. Maya Lin"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white focus:outline-none transition">
        </div>

        <div>
          <label for="email" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
            University Email *
          </label>
          <input id="email" name="email" type="email" required
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
            placeholder="e.g. maya@campus.edu"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white focus:outline-none transition">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="studentStaffId" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
              Student / Staff ID
            </label>
            <input id="studentStaffId" name="studentStaffId" type="text"
              value="<%= typeof formData !== 'undefined' && formData.studentStaffId ? formData.studentStaffId : '' %>"
              placeholder="e.g. STU-2026-1044"
              class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white focus:outline-none transition">
          </div>

          <div>
            <label for="phone" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
              Phone Number
            </label>
            <input id="phone" name="phone" type="tel"
              value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
              placeholder="e.g. +1 555-0199"
              class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white focus:outline-none transition">
          </div>
        </div>

        <div>
          <label for="role" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
            Register As (Role)
          </label>
          <select id="role" name="role" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none transition">
            <option value="passenger" selected>Student / Faculty Passenger</option>
            <option value="driver">Campus Shuttle Driver</option>
          </select>
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
            Password (min 6 chars) *
          </label>
          <input id="password" name="password" type="password" required
            placeholder="••••••••"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white focus:outline-none transition">
        </div>

        <div>
          <label for="confirmPassword" class="block text-xs font-bold uppercase text-slate-600 tracking-wider mb-1">
            Confirm Password *
          </label>
          <input id="confirmPassword" name="confirmPassword" type="password" required
            placeholder="••••••••"
            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white focus:outline-none transition">
        </div>

        <button type="submit" class="w-full py-2.5 px-4 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl shadow-md hover:shadow transition">
          Create Account
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-slate-500">
        Already registered? 
        <a href="/login" class="font-bold text-brand-600 hover:text-brand-800">Sign in here</a>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
