<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      
      <!-- Left side: Brand & Primary Navigation -->
      <div class="flex items-center space-x-8">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-700 to-brand-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-bus text-lg"></i>
          </div>
          <div>
            <span class="text-lg font-bold tracking-tight text-slate-900 group-hover:text-brand-600 transition">Campus Ride</span>
            <span class="block text-[10px] uppercase font-semibold text-brand-600 tracking-wider">Transport System</span>
          </div>
        </a>

        <div class="hidden md:flex items-center space-x-1">
          <a href="/trips" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath === '/trips' ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
            <i class="fa-solid fa-route mr-1.5 text-slate-400"></i> Find Rides
          </a>

          <% if (currentUser) { %>
            <a href="/my-bookings" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath === '/my-bookings' ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
              <i class="fa-solid fa-ticket mr-1.5 text-slate-400"></i> My Bookings
            </a>

            <% if (currentUser.role === 'driver' || currentUser.role === 'admin') { %>
              <a href="/driver" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath.startsWith('/driver') ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
                <i class="fa-solid fa-id-card-clip mr-1.5 text-amber-500"></i> Driver Portal
              </a>
            <% } %>

            <% if (currentUser.role === 'admin') { %>
              <div class="relative group">
                <button class="px-3 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-1 <%= currentPath.startsWith('/admin') ? 'bg-purple-50 text-purple-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
                  <i class="fa-solid fa-shield-halved mr-1 text-purple-600"></i>
                  <span>Admin Command</span>
                  <i class="fa-solid fa-chevron-down text-xs ml-1"></i>
                </button>
                <div class="absolute left-0 mt-1 w-56 bg-white border border-slate-200 rounded-xl shadow-lg py-2 hidden group-hover:block transition-all z-50">
                  <a href="/admin" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-gauge w-5 mr-2 text-slate-400"></i> Dashboard Overview
                  </a>
                  <a href="/admin/trips" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-calendar-days w-5 mr-2 text-slate-400"></i> Trip Dispatch
                  </a>
                  <a href="/admin/routes" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-map-location-dot w-5 mr-2 text-slate-400"></i> Routes
                  </a>
                  <a href="/admin/stops" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-location-dot w-5 mr-2 text-slate-400"></i> Campus Stops
                  </a>
                  <a href="/admin/vehicles" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-van-shuttle w-5 mr-2 text-slate-400"></i> Fleet Vehicles
                  </a>
                  <a href="/admin/bookings" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-book-bookmark w-5 mr-2 text-slate-400"></i> All Bookings
                  </a>
                  <a href="/admin/users" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-purple-700">
                    <i class="fa-solid fa-users-gear w-5 mr-2 text-slate-400"></i> Manage Users
                  </a>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- Right side: Authentication / Profile -->
      <div class="hidden md:flex items-center space-x-3">
        <% if (currentUser) { %>
          <div class="flex items-center space-x-3 border-l border-slate-200 pl-4">
            <div class="text-right">
              <span class="block text-sm font-semibold text-slate-900 leading-tight"><%= currentUser.name %></span>
              <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded-full uppercase <%= currentUser.role === 'admin' ? 'bg-purple-100 text-purple-700' : (currentUser.role === 'driver' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700') %>">
                <%= currentUser.role %>
              </span>
            </div>
            <a href="/profile" class="w-9 h-9 rounded-full bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 flex items-center justify-center border border-slate-200 transition" title="Profile">
              <i class="fa-solid fa-user text-sm"></i>
            </a>
            <a href="/logout" class="text-slate-500 hover:text-rose-600 text-sm font-medium px-2 py-1 transition flex items-center" title="Log Out">
              <i class="fa-solid fa-arrow-right-from-bracket text-base"></i>
            </a>
          </div>
        <% } else { %>
          <a href="/login" class="text-sm font-semibold text-slate-700 hover:text-brand-600 px-3 py-2 transition">Sign In</a>
          <a href="/register" class="text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 px-4 py-2 rounded-xl shadow-sm transition hover:shadow">Sign Up</a>
        <% } %>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button id="mobile-menu-btn" type="button" class="text-slate-600 hover:text-slate-900 p-2 rounded-lg">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1">
    <a href="/trips" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 hover:bg-slate-50">Find Rides</a>
    <% if (currentUser) { %>
      <a href="/my-bookings" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 hover:bg-slate-50">My Bookings</a>
      <% if (currentUser.role === 'driver' || currentUser.role === 'admin') { %>
        <a href="/driver" class="block px-3 py-2 rounded-lg text-base font-medium text-amber-700 hover:bg-amber-50">Driver Portal</a>
      <% } %>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin" class="block px-3 py-2 rounded-lg text-base font-medium text-purple-700 hover:bg-purple-50">Admin Dashboard</a>
        <a href="/admin/trips" class="block px-3 py-2 rounded-lg text-base font-medium text-purple-700 hover:bg-purple-50">Trip Dispatch</a>
        <a href="/admin/vehicles" class="block px-3 py-2 rounded-lg text-base font-medium text-purple-700 hover:bg-purple-50">Fleet Vehicles</a>
      <% } %>
      <div class="pt-3 border-t border-slate-200 mt-2">
        <div class="px-3 py-1 font-semibold text-slate-900"><%= currentUser.name %> (<%= currentUser.role %>)</div>
        <a href="/profile" class="block px-3 py-2 text-slate-600">My Profile</a>
        <a href="/logout" class="block px-3 py-2 text-rose-600 font-medium">Log Out</a>
      </div>
    <% } else { %>
      <div class="pt-2 flex flex-col space-y-2">
        <a href="/login" class="text-center py-2 text-slate-700 font-medium border border-slate-200 rounded-lg">Sign In</a>
        <a href="/register" class="text-center py-2 bg-brand-600 text-white font-medium rounded-lg">Sign Up</a>
      </div>
    <% } %>
  </div>
</nav>
