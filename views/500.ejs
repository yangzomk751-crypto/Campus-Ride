<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card card-campus border-0 shadow-sm p-5 bg-white">
        <div class="display-1 fw-extrabold text-danger mb-3">500</div>
        <h3 class="fw-bold text-dark mb-2">Internal Server Error</h3>
        <p class="text-muted small mb-4">
          <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
        </p>
        <% if (typeof error !== 'undefined' && error && error.stack) { %>
          <div class="text-start bg-light p-3 rounded-3 mb-4 overflow-auto" style="max-height: 200px;">
            <pre class="small text-danger mb-0"><code><%= error.stack %></code></pre>
          </div>
        <% } %>
        <div>
          <a href="/dashboard" class="btn btn-primary-blue fw-bold px-4 py-2">
            <i class="fa-solid fa-gauge-high me-1"></i> Return to Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
