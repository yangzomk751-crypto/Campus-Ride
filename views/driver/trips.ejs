<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <span class="badge bg-primary text-white fw-bold mb-1 text-uppercase">Trip Log</span>
        <h2 class="fw-extrabold text-white mb-0">My Trips & Schedule</h2>
        <small class="text-light text-opacity-75">
          Driver: <%= driver.full_name %> • Update trip statuses and record cash payments received.
        </small>
      </div>

      <div>
        <a href="/driver" class="btn btn-outline-light btn-sm rounded-pill px-3">
          <i class="fa-solid fa-gauge me-1"></i> Driver Console
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <!-- Status Filter Pills -->
  <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
    <a href="/driver/trips?filter=upcoming" class="btn btn-sm <%= currentFilter === 'upcoming' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">
      <i class="fa-solid fa-clock me-1"></i> Active & Upcoming
    </a>
    <a href="/driver/trips?filter=completed" class="btn btn-sm <%= currentFilter === 'completed' ? 'btn-success' : 'btn-outline-success' %> rounded-pill px-3">
      <i class="fa-solid fa-flag-checkered me-1"></i> Completed Trips
    </a>
    <a href="/driver/trips?filter=bus" class="btn btn-sm <%= currentFilter === 'bus' ? 'btn-info text-white' : 'btn-outline-info' %> rounded-pill px-3">
      <i class="fa-solid fa-bus me-1"></i> Assigned Buses
    </a>
  </div>

  <% if (trips && trips.length > 0) { %>
    <div class="row g-3">
      <% trips.forEach(function(t) { %>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 transition-hover border-top border-4 <%= t.booking_status === 'Completed' ? 'border-success' : (t.booking_status === 'In Progress' ? 'border-info' : 'border-primary') %>">
            
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="badge <%= t.service_type === 'Weekday Ride' ? 'bg-warning text-dark' : 'bg-primary' %> me-1">
                  <%= t.service_type %>
                </span>
                <% if (t.booking_status === 'In Progress') { %>
                  <span class="badge bg-info text-dark"><i class="fa-solid fa-spinner fa-spin me-1"></i> In Progress</span>
                <% } else if (t.booking_status === 'Completed') { %>
                  <span class="badge bg-success text-white"><i class="fa-solid fa-flag-checkered me-1"></i> Completed</span>
                <% } else { %>
                  <span class="badge bg-primary text-white"><i class="fa-solid fa-check me-1"></i> Confirmed</span>
                <% } %>
              </div>
              <span class="fs-5 fw-bold text-navy">Nu. <%= parseFloat(t.total_fare || 0).toLocaleString() %></span>
            </div>

            <h5 class="fw-bold text-navy mb-1"><%= t.destination %></h5>
            <small class="text-muted d-block mb-3">
              <i class="fa-solid fa-location-dot text-primary me-1"></i> Pickup: <%= t.pickup_location %>
            </small>

            <div class="p-2 bg-light rounded-3 border small mb-3">
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Date & Time:</span>
                <strong><%= formatDate(t.travel_date) %> at <%= formatTime(t.departure_time) %></strong>
              </div>
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Passenger:</span>
                <strong><%= t.passenger_name %> (<%= t.passenger_phone %>)</strong>
              </div>
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Passenger Count:</span>
                <strong><%= t.passenger_count %> Pax <%= t.ride_sharing_opted ? '(Shared)' : '' %></strong>
              </div>
              <div class="d-flex justify-content-between py-1">
                <span class="text-muted">Cash Payment:</span>
                <% if (t.payment_status === 'Paid') { %>
                  <span class="badge bg-success text-white"><i class="fa-solid fa-check me-1"></i> Paid</span>
                <% } else if (t.payment_status === 'Waived') { %>
                  <span class="badge bg-info text-white">Waived</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-start me-1"></i> Pending Cash</span>
                <% } %>
              </div>
            </div>

            <!-- Actions Row: Status Update and Payment -->
            <div class="mt-auto pt-2 border-top">
              <% if (t.booking_status !== 'Completed' && t.booking_status !== 'Cancelled') { %>
                <form action="/driver/trips/<%= t.booking_id %>/status" method="POST" class="d-flex gap-2 mb-2">
                  <select name="status" class="form-select form-select-sm rounded-pill">
                    <option value="In Progress" <%= t.booking_status === 'In Progress' ? 'selected' : '' %>>Mark In Progress</option>
                    <option value="Completed">Mark Completed</option>
                  </select>
                  <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                    Update
                  </button>
                </form>
              <% } %>

              <!-- Record Cash Payment Form (If Pending) -->
              <% if (t.payment_status === 'Pending') { %>
                <form action="/driver/trips/<%= t.booking_id %>/payment" method="POST" onsubmit="return confirm('Confirm receipt of Nu. <%= t.total_fare %> in cash from passenger?');">
                  <input type="hidden" name="notes" value="Cash collected by Driver <%= driver.full_name %> upon completion">
                  <button type="submit" class="btn btn-outline-success btn-sm w-100 rounded-pill fw-bold">
                    <i class="fa-solid fa-hand-holding-dollar me-1"></i> Record Cash Payment Received (Nu. <%= t.total_fare %>)
                  </button>
                </form>
              <% } else if (t.payment_status === 'Paid') { %>
                <span class="badge bg-success-subtle text-success w-100 py-2 d-block">
                  <i class="fa-solid fa-circle-check me-1"></i> Cash Payment Settled
                </span>
              <% } %>
            </div>

          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
      <i class="fa-solid fa-route fs-1 text-muted opacity-50 mb-3"></i>
      <h6 class="fw-bold text-navy">No trips found in this category</h6>
      <p class="small text-muted mb-0">Check incoming ride requests to accept new rides.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
