<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-warning text-dark fw-bold text-uppercase">Driver Console</span>
          <% if (isVerified) { %>
            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i> Admin Verified</span>
          <% } else { %>
            <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-start me-1"></i> Pending Verification</span>
          <% } %>
        </div>
        <h2 class="fw-extrabold text-white mb-0"><%= driver.full_name %></h2>
        <small class="text-light text-opacity-75">
          License: <%= driver.license_number %> • Vehicle: <%= driver.vehicle_model || 'Unassigned' %> (<%= driver.registration_number || 'N/A' %>)
        </small>
      </div>

      <!-- Live Availability Toggles -->
      <div class="d-flex flex-wrap gap-2">
        <form action="/driver/availability" method="POST" class="d-inline">
          <button type="submit" class="btn <%= driver.availability_status === 'Available' ? 'btn-success' : 'btn-outline-light' %> btn-sm rounded-pill px-3 shadow-sm" <%= !isVerified ? 'disabled' : '' %>>
            <i class="fa-solid fa-circle-dot me-1"></i>
            General: <strong><%= driver.availability_status %></strong>
          </button>
        </form>

        <form action="/driver/weekday-availability" method="POST" class="d-inline">
          <button type="submit" class="btn <%= driver.weekday_available ? 'btn-warning text-dark fw-bold' : 'btn-outline-warning' %> btn-sm rounded-pill px-3 shadow-sm" <%= !isVerified ? 'disabled' : '' %>>
            <i class="fa-solid fa-person-walking-luggage me-1"></i>
            Weekday Rides: <strong><%= driver.weekday_available ? 'Active (Nu. 100)' : 'Inactive' %></strong>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <!-- Verification Alert (If not approved) -->
  <% if (!isVerified) { %>
    <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4">
      <div class="d-flex align-items-center gap-3">
        <i class="fa-solid fa-shield-halved fs-2 text-warning"></i>
        <div>
          <h5 class="fw-bold mb-1">Account Awaiting Administrative Verification</h5>
          <p class="small text-muted mb-0">
            Your driving credentials (<%= driver.license_number %>) are currently under review by the Sherubtse College Transport Administration. You will be able to accept ride requests as soon as your account is approved.
          </p>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Metrics Grid -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-warning">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Incoming Requests</span>
          <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2">
            <i class="fa-solid fa-bell fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= incomingCount %></div>
        <a href="/driver/requests" class="small text-decoration-none fw-semibold">View Requests →</a>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-primary">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Upcoming Trips</span>
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2">
            <i class="fa-solid fa-route fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= upcomingCount %></div>
        <a href="/driver/trips" class="small text-decoration-none fw-semibold">View Trips →</a>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-info">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Assigned Buses</span>
          <div class="bg-info bg-opacity-10 text-info rounded-circle p-2">
            <i class="fa-solid fa-bus fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= assignedBusCount %></div>
        <a href="/driver/bus-trips" class="small text-decoration-none fw-semibold">View Bus Trips →</a>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-success">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Pending Cash</span>
          <div class="bg-success bg-opacity-10 text-success rounded-circle p-2">
            <i class="fa-solid fa-money-bill-wave fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= pendingPaymentsCount %></div>
        <a href="/driver/payments" class="small text-decoration-none fw-semibold">Record Cash →</a>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Incoming Ride Requests Preview -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
          <h5 class="fw-bold text-navy mb-0">
            <i class="fa-solid fa-bell text-warning me-2"></i> Eligible Ride Requests
          </h5>
          <a href="/driver/requests" class="small text-decoration-none fw-semibold">View All (<%= incomingCount %>)</a>
        </div>

        <% if (incomingRequests && incomingRequests.length > 0) { %>
          <div class="list-group list-group-flush gap-2">
            <% incomingRequests.forEach(function(r) { %>
              <div class="list-group-item border rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div>
                    <span class="badge <%= r.service_type === 'Weekday Ride' ? 'bg-warning text-dark' : 'bg-primary' %> me-1">
                      <%= r.service_type %>
                    </span>
                    <span class="badge bg-secondary"><%= r.booking_subtype %></span>
                  </div>
                  <span class="fs-6 fw-bold text-navy">Nu. <%= parseFloat(r.total_fare || 0).toLocaleString() %></span>
                </div>

                <h6 class="fw-bold text-navy mb-1"><%= r.destination %></h6>
                <small class="text-muted d-block mb-2">
                  <i class="fa-solid fa-location-dot text-primary me-1"></i> Pickup: <%= r.pickup_location %> • <%= r.travel_date %> at <%= r.departure_time %>
                </small>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                  <small class="text-muted">Passenger: <strong><%= r.passenger_name %></strong> (<%= r.passenger_phone %>)</small>
                  <div class="d-flex gap-2">
                    <form action="/driver/requests/<%= r.booking_id %>/accept" method="POST">
                      <button type="submit" class="btn btn-success btn-sm rounded-pill px-3" <%= !isVerified ? 'disabled' : '' %>>
                        <i class="fa-solid fa-check me-1"></i> Accept
                      </button>
                    </form>
                    <form action="/driver/requests/<%= r.booking_id %>/reject" method="POST">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2">
                        Reject
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-inbox fs-2 opacity-50 mb-2"></i>
            <p class="small mb-0">No incoming ride requests at this moment.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Upcoming Trips Preview -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
          <h5 class="fw-bold text-navy mb-0">
            <i class="fa-solid fa-route text-primary me-2"></i> Active & Upcoming Trips
          </h5>
          <a href="/driver/trips" class="small text-decoration-none fw-semibold">View Trips</a>
        </div>

        <% if (upcomingTrips && upcomingTrips.length > 0) { %>
          <div class="list-group list-group-flush gap-2">
            <% upcomingTrips.forEach(function(t) { %>
              <div class="list-group-item border rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="badge <%= t.booking_status === 'In Progress' ? 'bg-info text-dark' : 'bg-primary' %>">
                    <%= t.booking_status %>
                  </span>
                  <small class="text-muted"><%= t.travel_date %> <%= t.departure_time %></small>
                </div>
                <h6 class="fw-bold text-navy mb-1"><%= t.destination %></h6>
                <small class="text-muted d-block mb-2">Passenger: <%= t.passenger_name %> (<%= t.passenger_phone %>)</small>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                  <span class="fw-bold text-navy">Nu. <%= parseFloat(t.total_fare || 0).toLocaleString() %></span>
                  <a href="/driver/trips" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    Update Status
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-calendar-check fs-2 opacity-50 mb-2"></i>
            <p class="small mb-0">You have no upcoming confirmed trips.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
