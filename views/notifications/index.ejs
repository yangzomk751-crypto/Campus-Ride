<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
          <h2 class="fw-extrabold text-dark mb-1">
            <i class="fa-solid fa-bell text-warning me-2"></i>Notifications
          </h2>
          <p class="text-muted small mb-0">System alerts, booking updates, passenger requests, and trip status changes</p>
        </div>

        <% if (notifications && notifications.some(n => !n.is_read)) { %>
          <form action="/notifications/mark-all-read" method="POST">
            <button type="submit" class="btn btn-outline-primary btn-sm fw-semibold">
              <i class="fa-solid fa-check-double me-1"></i> Mark All as Read
            </button>
          </form>
        <% } %>
      </div>

      <div class="card card-campus border-0 shadow-sm p-4 bg-white">
        <% if (notifications && notifications.length > 0) { %>
          <div class="d-flex flex-column gap-3">
            <% notifications.forEach(notif => { %>
              <div class="p-3 rounded-3 notif-item <%= !notif.is_read ? 'unread' : '' %>" id="notif-<%= notif.notification_id %>">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                  <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle p-2 bg-light text-primary">
                      <i class="fa-solid fa-circle-info"></i>
                    </span>
                    <strong class="text-dark"><%= notif.title %></strong>
                    <% if (!notif.is_read) { %>
                      <span class="badge bg-warning text-dark badge-unread" style="font-size: 0.65rem;">New</span>
                    <% } %>
                  </div>
                  <small class="text-muted text-nowrap" style="font-size: 0.75rem;">
                    <%= new Date(notif.created_at).toLocaleString() %>
                  </small>
                </div>

                <p class="small text-secondary mb-2 ps-4 ms-2">
                  <%= notif.message %>
                </p>

                <div class="d-flex justify-content-between align-items-center ps-4 ms-2">
                  <% if (notif.link) { %>
                    <a href="<%= notif.link %>" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-primary small">
                      View Details &rarr;
                    </a>
                  <% } else { %>
                    <div></div>
                  <% } %>

                  <% if (!notif.is_read) { %>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" onclick="markNotificationRead(<%= notif.notification_id %>)">
                      Mark Read
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state py-5">
            <i class="fa-regular fa-bell-slash empty-state-icon"></i>
            <h5 class="fw-bold text-dark">No Notifications</h5>
            <p class="text-muted small mb-0">You are completely up to date.</p>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>
