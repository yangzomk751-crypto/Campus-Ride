<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main>
  <!-- Hero Banner -->
  <section class="hero-campus text-center">
    <div class="container py-4">
      <span class="badge bg-warning text-dark text-uppercase px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">
        <i class="fa-solid fa-graduation-cap me-1"></i> Sherubtse College Transportation System
      </span>
      <h1 class="display-4 fw-extrabold text-white mb-3">
        Campus Taxi & College Bus Booking
      </h1>
      <p class="lead text-light opacity-90 mx-auto mb-4" style="max-width: 800px;">
        Book campus taxis for short-distance hostel and academic transfers at <strong>fixed travel rates</strong>, or reserve <strong>College Buses for class trips, department study tours</strong>, and educational visits.
      </p>

      <!-- Primary Action Buttons -->
      <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
        <a href="/book-taxi" class="btn btn-warning btn-lg px-4 py-3 fw-bold text-dark shadow rounded-pill">
          <i class="fa-solid fa-taxi me-2"></i> Book Campus Taxi (Fixed Fare)
        </a>
        <a href="/book-bus" class="btn btn-primary-blue btn-lg px-4 py-3 fw-bold shadow rounded-pill text-white">
          <i class="fa-solid fa-bus me-2"></i> Reserve Bus for Class Trips
        </a>
        <a href="/rates" class="btn btn-outline-light btn-lg px-4 py-3 fw-bold shadow rounded-pill">
          <i class="fa-solid fa-tags me-2"></i> View Fixed Rate Card
        </a>
      </div>

      <!-- Quick Availability Indicator -->
      <div class="d-inline-flex flex-wrap align-items-center gap-3 bg-dark bg-opacity-50 px-4 py-2 rounded-pill small border border-light border-opacity-25 text-white">
        <div>
          <i class="fa-solid fa-circle-check text-success me-1"></i> Active Fleet:
          <strong><%= typeof availableTaxis !== 'undefined' ? availableTaxis.length : 2 %> Taxis</strong> Available
        </div>
        <div>&bull;</div>
        <div>
          <strong><%= typeof availableBuses !== 'undefined' ? availableBuses.length : 2 %> College Buses</strong> On-Call
        </div>
        <div>&bull;</div>
        <div>
          <i class="fa-solid fa-clock text-warning me-1"></i> Standard Rates Guaranteed
        </div>
      </div>
    </div>
  </section>

  <div class="container py-5">
    
    <!-- 2 Primary Services Grid -->
    <div class="row g-4 mb-5">
      
      <!-- Service 1: Campus Taxi Booking (Short Distance & Fixed Rates) -->
      <div class="col-md-6">
        <div class="card card-campus h-100 p-4 border-0 shadow-sm" style="border-top: 5px solid var(--accent-orange) !important;">
          <div class="d-flex align-items-center mb-3">
            <span class="badge p-3 rounded-circle me-3 fs-3 text-white" style="background-color: var(--accent-orange);">
              <i class="fa-solid fa-taxi"></i>
            </span>
            <div>
              <h3 class="fw-bold mb-0">Campus Taxi Booking</h3>
              <small class="text-muted">Short-distance travel & fixed campus fares</small>
            </div>
          </div>
          <p class="text-secondary small mb-3">
            Convenient transfers between North/South Hostels, Drukgyel Academic Complex, Central Library, Cafeteria, and Kanglung Town Gate. Avoid missing lectures under heavy rain or carrying luggage across hills.
          </p>

          <!-- Fixed Rates Preview Pill -->
          <div class="p-3 rounded-3 bg-light border mb-4 small">
            <div class="fw-bold text-dark mb-2"><i class="fa-solid fa-tags text-primary me-1"></i> Fixed Standard Fares:</div>
            <div class="d-flex justify-content-between border-bottom py-1">
              <span>Hostels ⇄ Academic Blocks / Library</span>
              <strong class="text-primary">Nu. 30 (Fixed)</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom py-1">
              <span>Campus ⇄ Kanglung Town Market Gate</span>
              <strong class="text-primary">Nu. 50 (Fixed)</strong>
            </div>
            <div class="d-flex justify-content-between pt-1">
              <span>Kanglung ⇄ Trashigang Town (Shared)</span>
              <strong class="text-primary">Nu. 120 / seat</strong>
            </div>
          </div>

          <ul class="list-unstyled small text-secondary mb-4 d-flex flex-column gap-2">
            <li><i class="fa-solid fa-circle-check text-success me-2"></i> Accommodates 1 to 4 passengers per request</li>
            <li><i class="fa-solid fa-circle-check text-success me-2"></i> Automated dispatch with verified college taxi drivers</li>
            <li><i class="fa-solid fa-circle-check text-success me-2"></i> Real-time status tracking (`Pending` ➔ `Assigned` ➔ `Completed`)</li>
          </ul>

          <div class="mt-auto">
            <a href="/book-taxi" class="btn btn-warning w-100 fw-bold py-2 shadow-sm">
              <i class="fa-solid fa-taxi me-1"></i> Book Campus Taxi Now <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Service 2: College Bus Reservation (Class Trips & Group Excursions) -->
      <div class="col-md-6">
        <div class="card card-campus h-100 p-4 border-0 shadow-sm" style="border-top: 5px solid var(--primary-blue) !important;">
          <div class="d-flex align-items-center mb-3">
            <span class="badge p-3 rounded-circle me-3 fs-3 text-white" style="background-color: var(--primary-blue);">
              <i class="fa-solid fa-bus"></i>
            </span>
            <div>
              <h3 class="fw-bold mb-0">Reserve Bus for Class Trips</h3>
              <small class="text-muted">Educational visits, study tours & group activities</small>
            </div>
          </div>
          <p class="text-secondary small mb-3">
            Students, faculty, and class councils can reserve official Sherubtse College buses for curriculum excursions, botanical field surveys, research excursions, sports tournaments, and official group travel.
          </p>

          <!-- Fixed Rates Preview Pill -->
          <div class="p-3 rounded-3 bg-light border mb-4 small">
            <div class="fw-bold text-dark mb-2"><i class="fa-solid fa-tags text-primary me-1"></i> Standard Institutional Rates:</div>
            <div class="d-flex justify-content-between border-bottom py-1">
              <span>Class Trip: Trashigang Dzong & Court</span>
              <strong class="text-primary">Nu. 1,500 (Half-Day)</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom py-1">
              <span>Study Tour: Yonphula Meteorological Station</span>
              <strong class="text-primary">Nu. 2,200 (Full-Day)</strong>
            </div>
            <div class="d-flex justify-content-between pt-1">
              <span>Field Work: Gomphu Kora Heritage Excursion</span>
              <strong class="text-primary">Nu. 3,000 (Full-Day)</strong>
            </div>
          </div>

          <ul class="list-unstyled small text-secondary mb-4 d-flex flex-column gap-2">
            <li><i class="fa-solid fa-circle-check text-primary me-2"></i> Accommodates 5 to 50 passengers per reservation</li>
            <li><i class="fa-solid fa-circle-check text-primary me-2"></i> Structured class department and trip purpose review</li>
            <li><i class="fa-solid fa-circle-check text-primary me-2"></i> Conflict-free vehicle & heavy driver assignment (FR14)</li>
          </ul>

          <div class="mt-auto">
            <a href="/book-bus" class="btn btn-primary-blue w-100 fw-bold py-2 shadow-sm">
              <i class="fa-solid fa-bus me-1"></i> Submit Class Bus Reservation <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Official Fixed Travel Rate Card Section -->
    <div class="card card-campus border-0 shadow-sm p-4 p-md-5 mb-5 bg-white">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-1">Standard Campus Fare Card</span>
          <h3 class="fw-bold text-dark mb-0">Official Fixed Travel Rates</h3>
          <p class="text-muted small mb-0">Transparent fares approved by Sherubtse College Administration</p>
        </div>
        <a href="/rates" class="btn btn-outline-primary btn-sm fw-bold">
          View Complete Rate Sheet <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
          <thead class="table-light">
            <tr>
              <th>Service</th>
              <th>Journey / Route</th>
              <th>Pickup Point</th>
              <th>Destination</th>
              <th>Standard Fare</th>
              <th>Fare Structure</th>
              <th>Estimated Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof fixedRates !== 'undefined' && fixedRates.length > 0) { %>
              <% fixedRates.slice(0, 6).forEach(rate => { %>
                <tr>
                  <td>
                    <span class="badge <%= rate.service_type === 'Taxi' ? 'bg-warning text-dark' : 'bg-primary' %>">
                      <%= rate.service_type %>
                    </span>
                  </td>
                  <td class="fw-bold text-dark"><%= rate.route_name %></td>
                  <td><%= rate.pickup_location %></td>
                  <td><%= rate.destination %></td>
                  <td>
                    <strong class="text-primary fs-6">
                      <%= rate.standard_fare > 0 ? `Nu. ${rate.standard_fare}` : 'FREE' %>
                    </strong>
                  </td>
                  <td><span class="text-muted"><%= rate.fare_type %></span></td>
                  <td><i class="fa-regular fa-clock me-1 text-secondary"></i> <%= rate.estimated_duration || '10 mins' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- How the Booking Workflow Operates -->
    <div class="card card-campus border-0 shadow-sm p-4 p-md-5 mb-5 bg-white">
      <div class="text-center mb-5">
        <h3 class="fw-bold text-dark">Step-by-Step Booking Workflow</h3>
        <p class="text-muted small">Transparent request submission, administrative verification, and dispatch</p>
      </div>

      <div class="row g-4 text-center">
        <div class="col-md-3">
          <div class="p-3">
            <div class="badge rounded-circle p-3 mb-3 fs-3 text-white" style="background-color: var(--primary-blue); width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
              1
            </div>
            <h6 class="fw-bold">Submit Request</h6>
            <p class="text-muted small">
              Select Taxi or College Bus. Enter pickup, destination, date, passengers, and trip purpose.
            </p>
          </div>
        </div>

        <div class="col-md-3">
          <div class="p-3">
            <div class="badge rounded-circle p-3 mb-3 fs-3 text-white" style="background-color: var(--accent-orange); width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
              2
            </div>
            <h6 class="fw-bold">Admin Review</h6>
            <p class="text-muted small">
              Transport Office reviews request details and verifies academic validity.
            </p>
          </div>
        </div>

        <div class="col-md-3">
          <div class="p-3">
            <div class="badge rounded-circle p-3 mb-3 fs-3 text-white" style="background-color: var(--dark-navy); width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
              3
            </div>
            <h6 class="fw-bold">Dispatch & Assign</h6>
            <p class="text-muted small">
              Conflict-free algorithm allocates vehicle and licensed driver. Student gets instant alert.
            </p>
          </div>
        </div>

        <div class="col-md-3">
          <div class="p-3">
            <div class="badge rounded-circle p-3 mb-3 fs-3 text-white" style="background-color: #16a34a; width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
              4
            </div>
            <h6 class="fw-bold">Trip Execution</h6>
            <p class="text-muted small">
              Driver accesses duty manifest, meets students at pickup spot, and completes journey safely.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Academic Demo Login Callout -->
    <div class="card card-soft-blue p-4 border shadow-sm">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <h5 class="fw-bold mb-1 text-primary"><i class="fa-solid fa-key me-2"></i>One-Click Pre-Configured Demo Accounts</h5>
          <p class="text-secondary small mb-0">
            Test as <strong>Student Class Representative</strong>, <strong>Faculty Member</strong>, <strong>Taxi Driver</strong>, <strong>Bus Driver</strong>, or <strong>Transport Admin</strong>.
          </p>
        </div>
        <a href="/login" class="btn btn-primary-blue fw-bold text-nowrap">
          Open Login with Demo Fill <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
