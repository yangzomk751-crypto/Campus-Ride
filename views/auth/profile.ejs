<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<% 
  const u = (typeof user !== 'undefined' && user) ? user : ((typeof profileUser !== 'undefined' && profileUser) ? profileUser : (typeof currentUser !== 'undefined' ? currentUser : {}));
  const userFullName = u.full_name || u.fullName || 'User';
  const userRole = u.role || 'passenger';
  const userEmail = u.email || '';
  const userPhone = u.phone || '';
  const userPassengerType = u.passenger_type || u.passengerType || '';
  const userCreated = u.created_at ? new Date(u.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A';
%>

<main class="container py-5">
  <div class="row justify-content-center g-4">
    <!-- Left Column: User Summary Card -->
    <div class="col-lg-5 col-md-6">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, <%= userRole === 'admin' ? '#991b1b 0%, #1e293b 100%' : (userRole === 'driver' ? '#854d0e 0%, #1e293b 100%' : '#1e40af 0%, #172554 100%') %>);">
          <div class="rounded-circle bg-white text-dark mx-auto d-flex align-items-center justify-content-center fw-bold mb-3 shadow" style="width: 76px; height: 76px; font-size: 2rem;">
            <% if (userRole === 'admin') { %>
              <i class="fa-solid fa-shield-halved text-danger"></i>
            <% } else if (userRole === 'driver') { %>
              <i class="fa-solid fa-taxi text-warning"></i>
            <% } else { %>
              <i class="fa-solid fa-graduation-cap text-primary"></i>
            <% } %>
          </div>
          <h4 class="fw-bold mb-1 text-white"><%= userFullName %></h4>
          <small class="text-light text-opacity-80 d-block"><%= userEmail %></small>
          
          <div class="mt-3">
            <span class="badge <%= userRole === 'admin' ? 'bg-danger text-white' : (userRole === 'driver' ? 'bg-warning text-dark' : 'bg-info text-dark') %> text-uppercase fw-bold px-3 py-2 rounded-pill">
              <i class="fa-solid fa-id-badge me-1"></i>
              <%= userRole === 'admin' ? 'System Administrator' : (userRole === 'driver' ? 'Campus Driver' : `Passenger (${userPassengerType || 'Student'})`) %>
            </span>
          </div>
        </div>

        <div class="card-body p-4">
          <h6 class="text-uppercase text-muted fw-bold mb-3 small" style="letter-spacing: 0.5px;">Account Information</h6>
          <dl class="row small mb-4">
            <dt class="col-sm-5 text-muted">College / Base:</dt>
            <dd class="col-sm-7 text-navy fw-semibold">Sherubtse College, Kanglung</dd>

            <dt class="col-sm-5 text-muted">Mobile Phone:</dt>
            <dd class="col-sm-7 text-navy fw-semibold"><%= userPhone || 'Not provided' %></dd>

            <dt class="col-sm-5 text-muted">Account Status:</dt>
            <dd class="col-sm-7">
              <span class="badge bg-success-subtle text-success fw-bold">Active</span>
            </dd>

            <dt class="col-sm-5 text-muted">Member Since:</dt>
            <dd class="col-sm-7 text-navy"><%= userCreated %></dd>

            <% if (userRole === 'driver' && typeof driver !== 'undefined' && driver) { %>
              <dt class="col-sm-5 text-muted">License No:</dt>
              <dd class="col-sm-7 text-navy font-monospace"><%= driver.license_number %></dd>

              <dt class="col-sm-5 text-muted">Verification:</dt>
              <dd class="col-sm-7">
                <span class="badge <%= driver.verification_status === 'Approved' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= driver.verification_status %>
                </span>
              </dd>
            <% } %>
          </dl>

          <!-- Quick Navigation by Role -->
          <div class="d-grid gap-2 pt-3 border-top">
            <% if (userRole === 'admin') { %>
              <a href="/admin" class="btn btn-danger fw-bold rounded-pill">
                <i class="fa-solid fa-gauge me-2"></i> Open Admin Command Center
              </a>
              <a href="/admin/bookings" class="btn btn-outline-secondary rounded-pill">
                <i class="fa-solid fa-list-check me-2"></i> Manage All Bookings
              </a>
            <% } else if (userRole === 'driver') { %>
              <a href="/driver" class="btn btn-warning text-dark fw-bold rounded-pill">
                <i class="fa-solid fa-gauge me-2"></i> Open Driver Console
              </a>
              <a href="/driver/requests" class="btn btn-outline-secondary rounded-pill">
                <i class="fa-solid fa-bell me-2"></i> Incoming Ride Requests
              </a>
            <% } else { %>
              <a href="/dashboard" class="btn btn-primary fw-bold rounded-pill">
                <i class="fa-solid fa-gauge me-2"></i> Passenger Dashboard
              </a>
              <a href="/my-bookings" class="btn btn-outline-primary rounded-pill">
                <i class="fa-solid fa-calendar-check me-2"></i> My Bookings
              </a>
            <% } %>
            <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill mt-2">
              <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Sign Out
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Edit Profile Form -->
    <div class="col-lg-6 col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h5 class="fw-bold text-navy mb-1"><i class="fa-solid fa-user-pen text-primary me-2"></i> Edit Personal Details</h5>
        <p class="small text-muted mb-4">Keep your contact information updated so passengers and drivers can reach you.</p>

        <form action="/profile" method="POST">
          <div class="mb-3">
            <label for="fullName" class="form-label fw-bold small text-navy">Full Name *</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-user"></i></span>
              <input type="text" class="form-control" id="fullName" name="fullName" required value="<%= userFullName %>">
            </div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label fw-bold small text-navy">Email Address</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
              <input type="email" class="form-control bg-light" id="email" value="<%= userEmail %>" readonly title="Email address cannot be changed">
            </div>
            <small class="text-muted" style="font-size: 0.75rem;">Institutional email is fixed to maintain verifiable records.</small>
          </div>

          <div class="mb-4">
            <label for="phone" class="form-label fw-bold small text-navy">Mobile Phone Number *</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-phone"></i></span>
              <input type="tel" class="form-control" id="phone" name="phone" required value="<%= userPhone %>" placeholder="+975-17XXXXXX">
            </div>
            <small class="text-muted" style="font-size: 0.75rem;">Drivers and passengers use this number to contact you during rides.</small>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm">
            <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile Changes
          </button>
        </form>

        <hr class="my-4">

        <div class="p-3 bg-light rounded-3 border">
          <small class="fw-bold text-navy d-block mb-1">
            <i class="fa-solid fa-shield-halved text-secondary me-1"></i> Security & Password
          </small>
          <p class="small text-muted mb-0">
            To reset or change your account password, contact the Sherubtse Transport Administration at <code class="text-navy">admin@sherubtse.edu.bt</code>.
          </p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
