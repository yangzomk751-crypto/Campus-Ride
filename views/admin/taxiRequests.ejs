<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <h2 class="fw-extrabold text-white mb-0">Manage Campus Taxi Bookings</h2>
        <small class="text-light text-opacity-75">
          Book Now and Scheduled taxi trips across Bhutan's 20 Dzongkhags and local transit.
        </small>
      </div>

      <div>
        <a href="/admin/bookings" class="btn btn-outline-light btn-sm rounded-pill px-3">
          <i class="fa-solid fa-arrow-left me-1"></i> All Bookings
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-navy mb-0"><i class="fa-solid fa-taxi text-primary me-2"></i> Taxi Bookings (<%= bookings.length %>)</h5>
    </div>

    <% if (bookings && bookings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Ref #</th>
              <th>Passenger</th>
              <th>Mode</th>
              <th>Destination</th>
              <th>Pickup Spot</th>
              <th>Date / Time</th>
              <th>Pax & Hire Type</th>
              <th>Fare (Nu.)</th>
              <th>Assigned Driver</th>
              <th>Status</th>
              <th class="pe-4 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(b) { %>
              <tr>
                <td class="ps-4 fw-bold text-navy">#<%= b.booking_id %></td>
                <td>
                  <strong><%= b.passenger_name %></strong>
                  <small class="text-muted d-block"><%= b.passenger_phone %></small>
                </td>
                <td>
                  <span class="badge <%= b.booking_subtype === 'Book Now' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                    <%= b.booking_subtype %>
                  </span>
                </td>
                <td>
                  <strong class="text-navy"><%= b.destination %></strong>
                </td>
                <td><%= b.pickup_location %></td>
                <td><small class="text-muted"><%= formatDate(b.travel_date) %> • <%= formatTime(b.departure_time) %></small></td>
                <td>
                  <%= b.passenger_count %> Pax
                  <% if (b.ride_sharing_opted) { %>
                    <span class="badge bg-info text-white d-block mt-1">Shared</span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border d-block mt-1">Whole Taxi</span>
                  <% } %>
                </td>
                <td>
                  <strong class="text-navy">Nu. <%= parseFloat(b.total_fare || 0).toLocaleString() %></strong>
                </td>
                <td><%= b.driver_name || 'Driver Not Yet Assigned' %></td>
                <td>
                  <% if (b.booking_status === 'Confirmed') { %>
                    <span class="badge bg-primary text-white">Confirmed</span>
                  <% } else if (b.booking_status === 'In Progress') { %>
                    <span class="badge bg-info text-dark">In Progress</span>
                  <% } else if (b.booking_status === 'Completed') { %>
                    <span class="badge bg-success text-white">Completed</span>
                  <% } else if (b.booking_status === 'Cancelled' || b.booking_status === 'Rejected') { %>
                    <span class="badge bg-danger text-white"><%= b.booking_status %></span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td class="pe-4 text-end">
                  <a href="/bookings/<%= b.booking_id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    Details
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <p class="mb-0">No taxi requests found.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
