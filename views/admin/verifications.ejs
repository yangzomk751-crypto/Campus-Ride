<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2">
        <h2 class="fw-extrabold text-dark mb-0">Driver Verifications</h2>
        <span class="badge bg-danger text-uppercase">Admin</span>
      </div>
      <p class="text-muted small mb-0">Review student driver licenses and verify registered vehicles</p>
    </div>
    <a href="/admin" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
    </a>
  </div>

  <!-- Filter tabs -->
  <div class="btn-group mb-4">
    <a href="/admin/verifications?status=Pending" class="btn btn-sm <%= currentStatus === 'Pending' ? 'btn-primary-blue' : 'btn-outline-secondary' %>">
      Pending Review
    </a>
    <a href="/admin/verifications?status=Verified" class="btn btn-sm <%= currentStatus === 'Verified' ? 'btn-primary-blue' : 'btn-outline-secondary' %>">
      Verified Drivers
    </a>
    <a href="/admin/verifications?status=Rejected" class="btn btn-sm <%= currentStatus === 'Rejected' ? 'btn-primary-blue' : 'btn-outline-secondary' %>">
      Rejected
    </a>
    <a href="/admin/verifications?status=all" class="btn btn-sm <%= currentStatus === 'all' ? 'btn-primary-blue' : 'btn-outline-secondary' %>">
      All Records
    </a>
  </div>

  <div class="card card-campus border-0 shadow-sm p-4 bg-white">
    <% if (verifications && verifications.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
          <thead class="table-light">
            <tr>
              <th>Driver Details</th>
              <th>Student ID / Dept</th>
              <th>License Number</th>
              <th>Registered Vehicle</th>
              <th>Current Status</th>
              <th class="text-end">Verification Action</th>
            </tr>
          </thead>
          <tbody>
            <% verifications.forEach(v => { %>
              <tr>
                <td>
                  <strong class="text-dark d-block"><%= v.full_name %></strong>
                  <span class="text-muted" style="font-size: 0.75rem;"><%= v.email %> &bull; <%= v.phone %></span>
                </td>
                <td>
                  <code><%= v.student_id || 'STU-N/A' %></code>
                  <div class="text-muted" style="font-size: 0.75rem;"><%= v.department || 'General' %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="fa-solid fa-id-card me-1 text-primary"></i> <%= v.license_number %>
                  </span>
                </td>
                <td>
                  <% if (v.vehicle_model) { %>
                    <strong><%= v.vehicle_model %></strong> (<%= v.vehicle_type %>)
                    <div class="text-muted" style="font-size: 0.75rem;">Plate: <code><%= v.registration_number %></code> &bull; <%= v.capacity %> seats</div>
                  <% } else { %>
                    <span class="text-muted">No vehicle attached</span>
                  <% } %>
                </td>
                <td>
                  <% if (v.verification_status === 'Verified') { %>
                    <span class="badge badge-status-verified">Verified</span>
                  <% } else if (v.verification_status === 'Rejected') { %>
                    <span class="badge badge-status-rejected">Rejected</span>
                  <% } else { %>
                    <span class="badge badge-status-pending">Pending</span>
                  <% } %>
                  <% if (v.admin_notes) { %>
                    <div class="text-muted mt-1" style="font-size: 0.7rem;">Note: <%= v.admin_notes %></div>
                  <% } %>
                </td>
                <td class="text-end">
                  <button type="button" class="btn btn-sm btn-primary-blue" data-bs-toggle="modal" data-bs-target="#verifyModal-<%= v.verification_id %>">
                    Review & Decide
                  </button>
                </td>
              </tr>

              <!-- Modal for Decision -->
              <div class="modal fade" id="verifyModal-<%= v.verification_id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content border-0 shadow">
                    <form action="/admin/verifications/<%= v.verification_id %>" method="POST">
                      <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold">Driver Verification: <%= v.full_name %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="p-3 bg-light rounded-3 mb-3 small">
                          <div><strong>Driver Name:</strong> <%= v.full_name %> (<%= v.email %>)</div>
                          <div><strong>License Number:</strong> <code><%= v.license_number %></code></div>
                          <div><strong>Vehicle:</strong> <%= v.vehicle_model || 'None' %> (Plate: <%= v.registration_number || 'N/A' %>)</div>
                        </div>

                        <div class="mb-3">
                          <label class="form-label small fw-bold">Verification Decision *</label>
                          <select name="status" class="form-select" required>
                            <option value="Verified" <%= v.verification_status === 'Verified' ? 'selected' : '' %>>Verify Driver (Grant trip publishing permission)</option>
                            <option value="Rejected" <%= v.verification_status === 'Rejected' ? 'selected' : '' %>>Reject Driver (Incomplete/invalid documentation)</option>
                          </select>
                        </div>

                        <div class="mb-3">
                          <label class="form-label small fw-bold">Admin Assessment Notes</label>
                          <textarea name="adminNotes" class="form-control" rows="2" placeholder="e.g. Valid Royal Transport Authority driver license and college ID confirmed."><%= v.admin_notes || '' %></textarea>
                        </div>
                      </div>
                      <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-blue btn-sm fw-bold">Save Verification Status</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state py-4">
        <p class="text-muted small mb-0">No verification records found under this filter.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
