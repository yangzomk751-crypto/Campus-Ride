<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <span class="badge bg-warning text-dark fw-bold mb-1 text-uppercase">Dispatch Central</span>
        <h2 class="fw-extrabold text-white mb-0">All Campus Bookings</h2>
        <small class="text-light text-opacity-75">
          Monitor and filter bookings across Weekday Rides, Taxis, and College Buses.
        </small>
      </div>

      <div class="d-flex gap-2">
        <a href="/admin/weekday-rides" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3">
          Weekday Rides
        </a>
        <a href="/admin/taxi-requests" class="btn btn-primary btn-sm fw-bold rounded-pill px-3">
          Taxi Requests
        </a>
        <a href="/admin/bus-requests" class="btn btn-info btn-sm text-white fw-bold rounded-pill px-3">
          Bus Requests
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <!-- Filter Bar -->
  <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form action="/admin/bookings" method="GET" class="row g-2 align-items-center">
      <div class="col-md-3">
        <select name="type" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
          <option value="all" <%= filters.type === 'all' ? 'selected' : '' %>>All Service Types</option>
          <option value="Weekday Ride" <%= filters.type === 'Weekday Ride' ? 'selected' : '' %>>Weekday Rides</option>
          <option value="Taxi" <%= filters.type === 'Taxi' ? 'selected' : '' %>>Taxi Bookings</option>
          <option value="Bus" <%= filters.type === 'Bus' ? 'selected' : '' %>>Campus Bus Trips</option>
        </select>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
          <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
          <option value="Confirmed" <%= filters.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
          <option value="In Progress" <%= filters.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
          <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
          <option value="Cancelled" <%= filters.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>
      <div class="col-md-3">
        <input type="date" name="date" class="form-control form-control-sm rounded-pill" value="<%= filters.date || '' %>" onchange="this.form.submit()">
      </div>
      <div class="col-md-3 text-end">
        <a href="/admin/bookings" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reset Filters</a>
      </div>
    </form>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-navy mb-0"><i class="fa-solid fa-list-check text-primary me-2"></i> Booking Records (<%= bookings.length %>)</h5>
    </div>

    <% if (bookings && bookings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Ref #</th>
              <th>Passenger</th>
              <th>Service</th>
              <th>Route</th>
              <th>Travel Date</th>
              <th>Pax</th>
              <th>Total Fare (Nu.)</th>
              <th>Status</th>
              <th>Payment</th>
              <th class="pe-4 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(b) { %>
              <tr>
                <td class="ps-4 fw-bold text-navy">#<%= b.booking_id %></td>
                <td>
                  <strong><%= b.passenger_name %></strong>
                  <small class="text-muted d-block"><%= b.passenger_phone %></small>
                </td>
                <td>
                  <span class="badge <%= b.service_type === 'Weekday Ride' ? 'bg-warning text-dark' : (b.service_type === 'Taxi' ? 'bg-primary' : 'bg-info text-white') %>">
                    <%= b.service_type %>
                  </span>
                </td>
                <td>
                  <strong><%= b.destination %></strong>
                  <small class="text-muted d-block">From: <%= b.pickup_location %></small>
                </td>
                <td>
                  <small class="text-muted"><%= b.travel_date %> <%= b.departure_time %></small>
                </td>
                <td><%= b.passenger_count %></td>
                <td>
                  <strong class="text-navy">Nu. <%= parseFloat(b.total_fare || 0).toLocaleString() %></strong>
                </td>
                <td>
                  <% if (b.booking_status === 'Confirmed') { %>
                    <span class="badge bg-primary text-white">Confirmed</span>
                  <% } else if (b.booking_status === 'In Progress') { %>
                    <span class="badge bg-info text-dark">In Progress</span>
                  <% } else if (b.booking_status === 'Completed') { %>
                    <span class="badge bg-success text-white">Completed</span>
                  <% } else if (b.booking_status === 'Cancelled' || b.booking_status === 'Rejected') { %>
                    <span class="badge bg-danger text-white"><%= b.booking_status %></span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (b.payment_status === 'Paid') { %>
                    <span class="badge bg-success text-white">Paid</span>
                  <% } else if (b.payment_status === 'Waived') { %>
                    <span class="badge bg-info text-white">Waived</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td class="pe-4 text-end">
                  <a href="/bookings/<%= b.booking_id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    View
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <p class="mb-0">No bookings match the selected filters.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
