<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <span class="badge bg-warning text-dark fw-bold mb-1 text-uppercase">Fleet Administration</span>
        <h2 class="fw-extrabold text-white mb-0">Manage Fleet (Taxis & Buses)</h2>
        <small class="text-light text-opacity-75">
          Sherubtse College Institutional Vehicles and Registered Taxis
        </small>
      </div>

      <div>
        <button type="button" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
          <i class="fa-solid fa-plus me-1"></i> Register New Vehicle
        </button>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-navy mb-0"><i class="fa-solid fa-van-shuttle text-primary me-2"></i> Vehicle Fleet (<%= vehicles.length %>)</h5>
    </div>

    <% if (vehicles && vehicles.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Registration #</th>
              <th>Model Name</th>
              <th>Classification</th>
              <th>Passenger Capacity</th>
              <th>Assigned Driver</th>
              <th>Status</th>
              <th class="pe-4 text-end">Update Status</th>
            </tr>
          </thead>
          <tbody>
            <% vehicles.forEach(function(v) { %>
              <tr>
                <td class="ps-4">
                  <span class="badge bg-light text-dark border fs-6"><%= v.registration_number %></span>
                </td>
                <td>
                  <strong><%= v.vehicle_model %></strong>
                  <% if (v.description) { %>
                    <small class="text-muted d-block"><%= v.description %></small>
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= v.vehicle_type === 'Bus' ? 'bg-info text-white' : 'bg-primary' %>">
                    <%= v.vehicle_type %>
                  </span>
                </td>
                <td>
                  <strong class="text-navy"><%= v.capacity %> Passengers</strong>
                </td>
                <td>
                  <%= v.driver_name || 'Unassigned' %>
                </td>
                <td>
                  <% if (v.availability_status === 'Available') { %>
                    <span class="badge bg-success text-white">Available</span>
                  <% } else if (v.availability_status === 'Maintenance') { %>
                    <span class="badge bg-danger text-white">Maintenance</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Unavailable</span>
                  <% } %>
                </td>
                <td class="pe-4 text-end">
                  <form action="/admin/vehicles/<%= v.vehicle_id %>/status" method="POST" class="d-inline d-flex justify-content-end gap-1">
                    <select name="availabilityStatus" class="form-select form-select-sm" style="width: auto;">
                      <option value="Available" <%= v.availability_status === 'Available' ? 'selected' : '' %>>Available</option>
                      <option value="Unavailable" <%= v.availability_status === 'Unavailable' ? 'selected' : '' %>>Unavailable</option>
                      <option value="Maintenance" <%= v.availability_status === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
                    </select>
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-2">Save</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <p class="mb-0">No vehicles registered in fleet.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Add Vehicle Modal -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" aria-labelledby="addVehicleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-navy text-white">
        <h5 class="modal-title fw-bold" id="addVehicleModalLabel"><i class="fa-solid fa-plus me-2 text-warning"></i>Register Campus Vehicle</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/vehicles" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-bold small text-navy">Registration Number *</label>
            <input type="text" name="registrationNumber" class="form-control" placeholder="e.g. BG-1-0789 or BP-1-C1234" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small text-navy">Vehicle Model *</label>
            <input type="text" name="vehicleModel" class="form-control" placeholder="e.g. Eicher Starline 32-Seater / Maruti WagonR" required>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label fw-bold small text-navy">Type *</label>
              <select name="vehicleType" class="form-select" required>
                <option value="Taxi">Taxi</option>
                <option value="Bus">Bus</option>
                <option value="Van">Van</option>
                <option value="Car">Car</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label fw-bold small text-navy">Capacity (Pax) *</label>
              <input type="number" name="capacity" class="form-control" min="1" max="70" value="4" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small text-navy">Assign Driver (Optional)</label>
            <select name="driverId" class="form-select">
              <option value="">-- No driver assigned --</option>
              <% drivers.forEach(function(d) { %>
                <option value="<%= d.driver_id %>"><%= d.full_name %> (<%= d.license_number %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small text-navy">Description / Notes</label>
            <input type="text" name="description" class="form-control" placeholder="e.g. High clearance institutional bus">
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">Register Vehicle</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
