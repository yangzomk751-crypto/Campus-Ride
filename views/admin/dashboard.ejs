<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <span class="badge bg-warning text-dark fw-bold mb-1 text-uppercase">Central Administrator</span>
        <h2 class="fw-extrabold text-white mb-0">Transport Operations Console</h2>
        <small class="text-light text-opacity-75">
          Sherubtse College Campus Fleet & Booking Dispatch Management
        </small>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/admin/quotations" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3 shadow-sm">
          <i class="fa-solid fa-file-invoice-dollar me-1"></i> Custom Quotations
          <% if (quotationRequestsCount > 0) { %>
            <span class="badge bg-danger text-white ms-1"><%= quotationRequestsCount %></span>
          <% } %>
        </a>
        <a href="/admin/bus-requests" class="btn btn-info btn-sm text-white fw-bold rounded-pill px-3 shadow-sm">
          <i class="fa-solid fa-bus me-1"></i> Bus Requests
        </a>
        <a href="/admin/fare-chart" class="btn btn-outline-light btn-sm rounded-pill px-3">
          <i class="fa-solid fa-tags me-1"></i> 20 Dzongkhags Fare Chart
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <!-- Metrics Grid -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-primary">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Total Bookings</span>
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2">
            <i class="fa-solid fa-calendar-check fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= stats.total_bookings %></div>
        <div class="small text-muted d-flex justify-content-between mt-2 pt-2 border-top">
          <span>Pending: <strong><%= stats.pending_bookings %></strong></span>
          <span>Confirmed: <strong><%= stats.confirmed_bookings %></strong></span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-warning">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Registered Passengers</span>
          <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2">
            <i class="fa-solid fa-users fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= userStats.total_passengers %></div>
        <div class="small text-muted d-flex justify-content-between mt-2 pt-2 border-top">
          <span>Students: <strong><%= userStats.total_students %></strong></span>
          <span>Faculty/Staff: <strong><%= userStats.total_staff %></strong></span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-success">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Cash Revenue</span>
          <div class="bg-success bg-opacity-10 text-success rounded-circle p-2">
            <i class="fa-solid fa-money-bill-wave fs-5"></i>
          </div>
        </div>
        <div class="fs-3 fw-extrabold text-success mt-1">Nu. <%= paymentStats.paid_amount.toLocaleString() %></div>
        <div class="small text-muted d-flex justify-content-between mt-2 pt-2 border-top">
          <span>Paid: <strong><%= paymentStats.paid_count %></strong></span>
          <span>Waived: <strong><%= paymentStats.waived_count %></strong></span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-info">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Campus Fleet</span>
          <div class="bg-info bg-opacity-10 text-info rounded-circle p-2">
            <i class="fa-solid fa-car-side fs-5"></i>
          </div>
        </div>
        <div class="display-6 fw-bold text-navy"><%= totalVehicles %> Vehicles</div>
        <div class="small text-muted d-flex justify-content-between mt-2 pt-2 border-top">
          <span>Drivers: <strong><%= totalDrivers %></strong></span>
          <span>Pending Verif: <strong><%= pendingDriversCount %></strong></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Service Breakdown Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
        <div>
          <span class="text-muted small text-uppercase fw-bold">Weekday Rides</span>
          <h4 class="fw-bold text-warning mb-0"><%= stats.weekday_rides_count %> Rides</h4>
          <small class="text-muted">Hostel ⇄ Academic Block (Nu. 100)</small>
        </div>
        <a href="/admin/weekday-rides" class="btn btn-outline-warning btn-sm rounded-pill text-dark fw-bold">Manage</a>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
        <div>
          <span class="text-muted small text-uppercase fw-bold">Taxi Bookings</span>
          <h4 class="fw-bold text-primary mb-0"><%= stats.taxis_count %> Bookings</h4>
          <small class="text-muted">Book Now & Schedule Later</small>
        </div>
        <a href="/admin/taxi-requests" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">Manage</a>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
        <div>
          <span class="text-muted small text-uppercase fw-bold">Campus Buses</span>
          <h4 class="fw-bold text-info mb-0"><%= stats.buses_count %> Reservations</h4>
          <small class="text-muted">Class Study Tours & Groups</small>
        </div>
        <a href="/admin/bus-requests" class="btn btn-outline-info btn-sm rounded-pill fw-bold">Manage</a>
      </div>
    </div>
  </div>

  <!-- Recent Bookings Table -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-navy mb-0"><i class="fa-solid fa-list-check text-primary me-2"></i> Recent Booking Requests</h5>
      <a href="/admin/bookings" class="btn btn-outline-primary btn-sm rounded-pill px-3">View All Bookings</a>
    </div>

    <% if (recentBookings && recentBookings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Ref #</th>
              <th>Passenger</th>
              <th>Service</th>
              <th>Route / Destination</th>
              <th>Travel Date</th>
              <th>Fare (Nu.)</th>
              <th>Status</th>
              <th>Payment</th>
              <th class="pe-4 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% recentBookings.forEach(function(b) { %>
              <tr>
                <td class="ps-4 fw-bold text-navy">#<%= b.booking_id %></td>
                <td>
                  <strong><%= b.passenger_name %></strong>
                  <small class="text-muted d-block text-capitalize"><%= b.passenger_type || 'Student' %> • <%= b.passenger_phone %></small>
                </td>
                <td>
                  <span class="badge <%= b.service_type === 'Weekday Ride' ? 'bg-warning text-dark' : (b.service_type === 'Taxi' ? 'bg-primary' : 'bg-info text-white') %>">
                    <%= b.service_type %>
                  </span>
                </td>
                <td>
                  <strong class="text-navy"><%= b.destination %></strong>
                  <small class="text-muted d-block">From: <%= b.pickup_location %></small>
                </td>
                <td>
                  <small class="text-muted"><%= formatDate(b.travel_date) %> • <%= formatTime(b.departure_time) %></small>
                </td>
                <td>
                  <span class="fw-bold text-navy">Nu. <%= parseFloat(b.total_fare || 0).toLocaleString() %></span>
                </td>
                <td>
                  <% if (b.booking_status === 'Confirmed') { %>
                    <span class="badge bg-primary text-white">Confirmed</span>
                  <% } else if (b.booking_status === 'In Progress') { %>
                    <span class="badge bg-info text-dark">In Progress</span>
                  <% } else if (b.booking_status === 'Completed') { %>
                    <span class="badge bg-success text-white">Completed</span>
                  <% } else if (b.booking_status === 'Cancelled' || b.booking_status === 'Rejected') { %>
                    <span class="badge bg-danger text-white"><%= b.booking_status %></span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (b.payment_status === 'Paid') { %>
                    <span class="badge bg-success text-white">Paid</span>
                  <% } else if (b.payment_status === 'Waived') { %>
                    <span class="badge bg-info text-white">Waived</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td class="pe-4 text-end">
                  <a href="/bookings/<%= b.booking_id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    Details
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <p class="mb-0">No booking requests found.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
