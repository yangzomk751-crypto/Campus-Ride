<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <span class="badge bg-warning text-dark fw-bold mb-1 text-uppercase">Fleet Personnel</span>
        <h2 class="fw-extrabold text-white mb-0">Manage Drivers & Verification</h2>
        <small class="text-light text-opacity-75">
          Only verified drivers approved by the Admin can provide transportation services on campus.
        </small>
      </div>

      <div>
        <a href="/admin/vehicles" class="btn btn-outline-light btn-sm rounded-pill px-3">
          <i class="fa-solid fa-car me-1"></i> Fleet Management
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <%- include('../partials/alerts') %>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-navy mb-0"><i class="fa-solid fa-id-card text-warning me-2"></i> Registered Drivers (<%= drivers.length %>)</h5>
    </div>

    <% if (drivers && drivers.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Driver Name</th>
              <th>Phone</th>
              <th>License #</th>
              <th>Assigned Vehicle</th>
              <th>Weekday Rides</th>
              <th>Availability</th>
              <th>Verification Status</th>
              <th class="pe-4 text-end">Verification Action</th>
            </tr>
          </thead>
          <tbody>
            <% drivers.forEach(function(d) { %>
              <tr>
                <td class="ps-4">
                  <strong class="text-navy"><%= d.full_name %></strong>
                  <small class="text-muted d-block"><%= d.email %></small>
                </td>
                <td><%= d.phone %></td>
                <td>
                  <span class="badge bg-light text-dark border"><%= d.license_number %></span>
                </td>
                <td>
                  <% if (d.registration_number) { %>
                    <span class="fw-semibold text-dark"><%= d.vehicle_model %></span>
                    <small class="text-muted d-block">(<%= d.registration_number %> • <%= d.capacity %> Pax)</small>
                  <% } else { %>
                    <span class="text-muted small">No Vehicle Bound</span>
                  <% } %>
                </td>
                <td>
                  <% if (d.weekday_available) { %>
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-check me-1"></i> Active (Nu. 100)</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% } %>
                </td>
                <td>
                  <% if (d.availability_status === 'Available') { %>
                    <span class="badge bg-success-subtle text-success fw-bold"><i class="fa-solid fa-circle-dot me-1"></i> Available</span>
                  <% } else { %>
                    <span class="badge bg-light text-muted border">Unavailable</span>
                  <% } %>
                </td>
                <td>
                  <% if (d.verification_status === 'Approved') { %>
                    <span class="badge bg-success text-white"><i class="fa-solid fa-check-double me-1"></i> Approved</span>
                  <% } else if (d.verification_status === 'Pending') { %>
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-start me-1"></i> Pending</span>
                  <% } else if (d.verification_status === 'Deactivated') { %>
                    <span class="badge bg-danger text-white">Deactivated</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Rejected</span>
                  <% } %>
                </td>
                <td class="pe-4 text-end">
                  <form action="/admin/drivers/<%= d.driver_id %>/verify" method="POST" class="d-inline">
                    <% if (d.verification_status !== 'Approved') { %>
                      <button type="submit" name="verificationStatus" value="Approved" class="btn btn-success btn-sm rounded-pill px-3 fw-bold">
                        Approve
                      </button>
                    <% } %>
                    <% if (d.verification_status === 'Approved') { %>
                      <button type="submit" name="verificationStatus" value="Deactivated" class="btn btn-outline-danger btn-sm rounded-pill px-2">
                        Deactivate
                      </button>
                    <% } %>
                    <% if (d.verification_status === 'Pending') { %>
                      <button type="submit" name="verificationStatus" value="Rejected" class="btn btn-outline-secondary btn-sm rounded-pill px-2">
                        Reject
                      </button>
                    <% } %>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <p class="mb-0">No driver records found.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
