<%- include('../partials/header') %>
  <%- include('../partials/navbar') %>

    <div class="bg-navy py-4 text-white" style="background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%);">
      <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div>
            <span class="badge bg-warning text-dark fw-bold mb-1 text-uppercase">Passenger Console</span>
            <h2 class="fw-extrabold text-white mb-0">Welcome, <%= currentUser.fullName %>
            </h2>
            <small class="text-light text-opacity-75">
              Sherubtse <%= currentUser.passengerType==='staff' ? 'Faculty & Staff' : 'Student' %> Account • <%=
                  currentUser.phone %>
            </small>
          </div>

          <div class="d-flex gap-2">
            <a href="/my-bookings" class="btn btn-outline-light btn-sm rounded-pill px-3">
              <i class="fa-solid fa-list-check me-1"></i> My Bookings
            </a>
            <a href="/payments" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3">
              <i class="fa-solid fa-wallet me-1"></i> Payments
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="container py-4">
      <%- include('../partials/alerts') %>

        <!-- Quick Action Cards -->
        <div class="row g-3 mb-4">
          <!-- Weekday Ride -->
          <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-warning h-100">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                  <i class="fa-solid fa-person-walking-luggage fs-4"></i>
                </div>
                <span class="badge bg-warning text-dark fw-bold fs-6">Nu. 100 Fixed</span>
              </div>
              <h5 class="fw-bold text-navy mb-1">Weekday Rides</h5>
              <p class="small text-muted mb-3">
                Hostel ⇄ Academic Block campus transit (Mon - Fri). Choose an available driver and go.
              </p>
              <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                <small class="text-success fw-semibold">
                  <i class="fa-solid fa-circle-check me-1"></i>
                  <%= weekdayDriversCount %> Drivers Available
                </small>
                <a href="/weekday-rides" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3">
                  Request Ride
                </a>
              </div>
            </div>
          </div>

          <!-- Book Taxi -->
          <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-primary h-100">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                  <i class="fa-solid fa-taxi fs-4"></i>
                </div>
                <span class="badge bg-primary text-white fw-bold">1 - 4 Pax</span>
              </div>
              <h5 class="fw-bold text-navy mb-1">Book a Taxi</h5>
              <p class="small text-muted mb-3">
                Book now or schedule for later. Choose entire taxi hire or split fare via shared taxi.
              </p>
              <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                <small class="text-muted">Kanglung & 20 Dzongkhags</small>
                <a href="/book-taxi" class="btn btn-primary btn-sm fw-bold rounded-pill px-3">
                  Book Taxi
                </a>
              </div>
            </div>
          </div>

          <!-- Request Bus -->
          <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-top border-4 border-info h-100">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                  <i class="fa-solid fa-bus fs-4"></i>
                </div>
                <span class="badge bg-info text-white fw-bold">Friends & Groups</span>
              </div>
              <h5 class="fw-bold text-navy mb-1">Book a Group Bus</h5>
              <p class="small text-muted mb-3">
                Charter a bus for groups of friends, weekend trips, picnics, vacations, and student outings.
              </p>
              <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                <small class="text-muted">Admin Quoted & Assigned</small>
                <a href="/book-bus" class="btn btn-info btn-sm text-white fw-bold rounded-pill px-3">
                  Request Bus
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <!-- Active / Ongoing Bookings -->
          <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
              <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h5 class="fw-bold text-navy mb-0">
                  <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Active Bookings
                </h5>
                <a href="/my-bookings" class="small text-decoration-none fw-semibold">View All</a>
              </div>

              <% if (activeBookings && activeBookings.length> 0) { %>
                <div class="list-group list-group-flush gap-2">
                  <% activeBookings.forEach(function(b) { %>
                    <div class="list-group-item border rounded-3 p-3">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                          <span class="badge bg-secondary me-1">
                            <%= b.service_type %>
                          </span>
                          <% if (b.booking_status==='Confirmed' ) { %>
                            <span class="badge bg-primary text-white"><i class="fa-solid fa-check me-1"></i>
                              Confirmed</span>
                            <% } else if (b.booking_status==='In Progress' ) { %>
                              <span class="badge bg-info text-dark"><i class="fa-solid fa-spinner fa-spin me-1"></i> In
                                Progress</span>
                              <% } else { %>
                                <span class="badge bg-warning text-dark"><i
                                    class="fa-solid fa-hourglass-start me-1"></i> Pending</span>
                                <% } %>

                                  <% if (b.quotation_status==='Quoted' ) { %>
                                    <span class="badge bg-danger text-white"><i class="fa-solid fa-bell me-1"></i>
                                      Quotation Ready</span>
                                    <% } %>
                        </div>
                        <span class="fw-bold fs-6 text-navy">Nu. <%= parseFloat(b.total_fare || 0).toLocaleString() %>
                            </span>
                      </div>

                      <h6 class="fw-bold text-dark mb-1">
                        <%= b.pickup_location %> <i class="fa-solid fa-arrow-right text-muted mx-1"></i>
                          <%= b.destination %>
                      </h6>
                      <div class="small text-muted d-flex flex-wrap gap-3 mb-2">
                        <span><i class="fa-solid fa-calendar me-1"></i>
                          <%= formatDate(b.travel_date) %>
                        </span>
                        <span><i class="fa-solid fa-clock me-1"></i>
                          <%= formatTime(b.departure_time) %>
                        </span>
                        <span><i class="fa-solid fa-users me-1"></i>
                          <%= b.passenger_count %> pax
                        </span>
                        <% if (b.driver_name) { %>
                          <span><i class="fa-solid fa-id-badge text-success me-1"></i> Driver: <%= b.driver_name %>
                              </span>
                          <% } %>
                      </div>

                      <div class="text-end">
                        <a href="/bookings/<%= b.booking_id %>"
                          class="btn btn-outline-primary btn-sm rounded-pill px-3">
                          View Details & Actions
                        </a>
                      </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                  <div class="text-center py-4">
                    <i class="fa-solid fa-calendar-xmark fs-1 text-muted opacity-50 mb-2"></i>
                    <p class="text-muted small mb-3">You have no active bookings right now.</p>
                    <div class="d-flex justify-content-center gap-2">
                      <a href="/weekday-rides"
                        class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3">Weekday Ride</a>
                      <a href="/book-taxi" class="btn btn-primary btn-sm fw-bold rounded-pill px-3">Book Taxi</a>
                    </div>
                  </div>
                  <% } %>
            </div>
          </div>

          <!-- Payments & Help Sidebar -->
          <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
              <h5 class="fw-bold text-navy mb-3"><i class="fa-solid fa-wallet text-warning me-2"></i> Cash Payment
                Status</h5>
              <% if (pendingPaymentsCount> 0) { %>
                <div class="alert alert-warning border-0 py-2 small mb-3">
                  <i class="fa-solid fa-triangle-exclamation me-1"></i> You have <strong>
                    <%= pendingPaymentsCount %>
                  </strong> pending cash payment(s) to settle with drivers upon arrival.
                </div>
                <% } else { %>
                  <div class="alert alert-success border-0 py-2 small mb-3">
                    <i class="fa-solid fa-circle-check me-1"></i> All your completed ride payments are settled!
                  </div>
                  <% } %>

                    <a href="/payments" class="btn btn-outline-dark w-100 btn-sm rounded-pill fw-semibold">
                      <i class="fa-solid fa-receipt me-1"></i> View Payment History
                    </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
              <h6 class="fw-bold text-navy mb-2"><i class="fa-solid fa-shield-halved text-primary me-2"></i> Sherubtse
                Transport Support</h6>
              <p class="small text-muted mb-3">Need assistance with class bus reservations, group study trips, or
                special transit arrangements?</p>
              <div class="small text-muted mb-1"><i class="fa-solid fa-phone text-primary me-2"></i> +975-17111000</div>
              <div class="small text-muted"><i class="fa-solid fa-envelope text-primary me-2"></i>
                transport@sherubtse.edu.bt</div>
            </div>
          </div>
        </div>
    </div>

    <%- include('../partials/footer') %>