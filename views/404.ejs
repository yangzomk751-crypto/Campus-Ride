<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card card-campus border-0 shadow-sm p-5 bg-white">
        <div class="display-1 fw-extrabold text-primary mb-3">404</div>
        <h3 class="fw-bold text-dark mb-2">Page Not Found</h3>
        <p class="text-muted small mb-4">
          The requested page <code><%= typeof url !== 'undefined' ? url : '' %></code> does not exist on Campus Ride or has been moved.
        </p>
        <div>
          <a href="/" class="btn btn-primary-blue fw-bold px-4 py-2">
            <i class="fa-solid fa-house me-1"></i> Return Home
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
